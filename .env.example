# Public, browser-visible token. Restrict it to the exact local/production origins
# and only the Cesium ion assets the globe needs.
VITE_CESIUM_ION_TOKEN=

# Optional server-only key for NASA FIRMS active-fire observations.
FIRMS_MAP_KEY=

# Optional CAP/RSS override. The default is the IMD English CAP aggregation feed.
CAP_FEED_URL=https://cap-sources.s3.amazonaws.com/in-imd-en/rss.xml

# Optional server-only AI settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
